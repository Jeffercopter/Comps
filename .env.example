# Supabase — public (safe to expose to the browser, read-only via RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only. Never commit a real value; set it in Vercel project settings.
# Used exclusively by scripts/seed-supabase.mjs to load the catalog.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
