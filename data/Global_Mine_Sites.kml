            <Placemark id="4">
                <name>Acindar</name>
                <description>&lt;b&gt;Type:&lt;/b&gt; Smelter, Refinery&lt;br/&gt;&lt;b&gt;Commodities:&lt;/b&gt; Steel, rebar, steel bar, steel meshes, wire rod, barbed wire&lt;br/&gt;&lt;b&gt;Region:&lt;/b&gt; Santa Fe, Villa Constitucion&lt;br/&gt;&lt;b&gt;Owner/operator:&lt;/b&gt; ArcelorMittal S.A. (100%)&lt;br/&gt;&lt;b&gt;Source:&lt;/b&gt; &lt;a href=&quot;https://corporate-media.arcelormittal.com/media/yyjlil0y/2019-arcelormittal-annual-report-on-form-20-f.pdf ; https://storagearcelormittaluat.blob.core.windows.net/media/i55pz0cm/arcelormittal-20f-2014.pdf&quot;&gt;report&lt;/a&gt;</description>
